PORT=5000
FRONTEND_ORIGIN=http://localhost:4200
MONGO_URI=your_mongodb_connection_string
MONGO_MAX_POOL_SIZE=20
# Optional; set locally only if your system DNS refuses MongoDB SRV queries.
# MONGO_DNS_SERVERS=1.1.1.1
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
JWT_EXPIRE_SECONDS=7200
JWT_ISSUER=alrayan-palace-api
JWT_AUDIENCE=alrayan-palace-admin-api
